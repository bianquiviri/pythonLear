# Copy to .env and fill in real values. NEVER commit .env.
# --- PostgreSQL ---
POSTGRES_USER=spa
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=spa_db
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://spa:change-me-please@db:5432/spa_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=60
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT=60/minute
ENVIRONMENT=development

# --- Frontend (Nuxt) ---
FRONTEND_PORT=3000
# Optional: override API base (empty = same-origin, nginx proxies /api to backend)
NUXT_PUBLIC_API_BASE=

# --- Seed admin user ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
